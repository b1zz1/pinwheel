# Repo-wide ignores. Each package (frontend/, backend/, ...) keeps its own .gitignore
# for language-specific build output and dependencies.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.zed/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# Env files (opt in to committing with .env.example)
.env*
!.env.example

# Secrets
*.pem
